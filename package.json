{
  "name": "@koumatsumoto/everything-view",
  "version": "0.1.0",
  "private": true,
  "description": "A read-only local file and Git viewer",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koumatsumoto/everything-view.git"
  },
  "bin": {
    "ev": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp build --watch",
    "build": "vp build && vp pack && node scripts/assets.mjs && node scripts/licenses.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test run",
    "test:browser": "python tests/browser.py",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "24.12.0",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "marked": "18.1.3",
    "pdfjs-dist": "6.5.438",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  }
}
